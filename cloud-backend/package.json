{
  "name": "signage-cloud-backend",
  "version": "1.0.0",
  "description": "Cloud backend for Signage CMS",
  "main": "dist/index.js",
  "scripts": {
    "dev": "ts-node src/index.ts",
    "seed:admin": "ts-node scripts/createAdmin.ts",
    "indexes:media": "node scripts/ensure-media-indexes.js",
    "build": "tsc",
    "test": "jest --runInBand",
    "load-test": "node scripts/load-test.js",
    "backup:db": "node scripts/backup-mongo.js",
    "start": "node dist/index.js",
    "watch": "nodemon --exec ts-node src/index.ts"
  },
  "keywords": [
    "signage",
    "cms",
    "cloud"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1178.0",
    "@aws-sdk/lib-storage": "^3.1178.0",
    "@aws-sdk/s3-request-presigner": "^3.1178.0",
    "@types/compression": "^1.8.1",
    "@types/redis": "^4.0.10",
    "bcryptjs": "^2.4.3",
    "compression": "^1.8.2",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.0.0",
    "multer": "^1.4.5-lts.1",
    "socket.io": "^4.7.2"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.25",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/multer": "^1.4.11",
    "@types/node": "^20.10.0",
    "@types/supertest": "^7.2.1",
    "jest": "^30.5.2",
    "nodemon": "^3.0.2",
    "supertest": "^7.3.2",
    "ts-jest": "^29.4.15",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3"
  }
